---
import type { CollectionEntry } from 'astro:content';
import { STATUS_LABEL, moduleColor } from '../lib/site';

interface Props {
  module: CollectionEntry<'modules'>;
}
const { module: m } = Astro.props;
const color = moduleColor(m.data.order);
---

<a class="card" href={`/moduler/${m.id}`} style={`--c: ${color}`}>
  <span class="num">nr {m.data.order}</span>
  <h3>{m.data.title}</h3>
  <p>{m.data.summary}</p>
  {m.data.status !== 'publicerad' && <span class="chip">{STATUS_LABEL[m.data.status]}</span>}
</a>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.3rem 1.4rem 1.4rem;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }
  /* En färgklick i hörnet, modulens egen färg. */
  .card::after {
    content: '';
    position: absolute;
    top: -2.2rem;
    right: -2.2rem;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: var(--c);
    opacity: 0.16;
    transition: opacity 0.2s;
  }
  .card:hover {
    transform: translateY(-3px) rotate(-0.4deg);
    border-color: var(--c);
    box-shadow: 0 14px 28px -18px rgba(0, 0, 0, 0.45);
  }
  .card:hover::after {
    opacity: 0.3;
  }
  .num {
    font: italic 600 1.05rem / 1 var(--font-display);
    font-variation-settings: 'SOFT' 100;
    color: var(--c);
  }
  p {
    color: var(--dim);
  }
  .chip {
    justify-self: start;
  }
</style>
