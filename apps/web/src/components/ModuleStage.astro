---
// Modulens film + reglage (klient-ö). Visar en platshållare om modulen
// ännu inte har någon interaktiv del.
import { hasInteractive } from '../lib/interactive';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const interactive = hasInteractive(slug);
---

{interactive ? (
  <div class="module-host" data-module={slug}>
    <p class="loading mono">Laddar modulen …</p>
  </div>
) : (
  <div class="placeholder" role="img" aria-label="Plats för modulens film">
    <p class="mono">Modulens film kommer här.</p>
  </div>
)}

<script>
  import '@nastasteg/engine/module/player.css';
  import { INTERACTIVE_MODULES } from '../lib/interactive';
  import { type ModulePlayerHandle, mountModulePlayer } from '@nastasteg/engine/module/player';
  import type { ModuleDefinition } from '@nastasteg/engine/module/types';

  // Länkar med data-seek="<del-id>#<kapitel-id>" (t.ex. från quizet) hoppar till kapitlet.
  const players = new Map<string, { def: ModuleDefinition; handle: ModulePlayerHandle; section: HTMLElement }>();
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest<HTMLElement>('[data-seek]');
    if (!a) return;
    const [part, chapter] = (a.dataset.seek ?? '').split('#');
    const p = players.get(part);
    const ch = p?.def.chapters.find((c) => c.id === chapter);
    if (!p || !ch) return;
    e.preventDefault();
    p.handle.controller.seek(ch.start);
    p.handle.controller.pause();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    p.section.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    p.section.querySelector<HTMLElement>('.nsm-play')?.focus({ preventScroll: true });
  });

  for (const host of document.querySelectorAll<HTMLElement>('[data-module]')) {
    const load = INTERACTIVE_MODULES[host.dataset.module ?? ''];
    if (!load) continue;
    load()
      .then(({ parts }) => {
        host.innerHTML = '';
        for (const def of parts) {
          const section = document.createElement('section');
          section.className = 'module-part';
          section.id = `del-${def.id}`;
          const h = document.createElement('h2');
          h.className = 'eyebrow';
          h.textContent = def.title;
          const el = document.createElement('div');
          section.append(h, el);
          host.appendChild(section);
          players.set(def.id, { def, handle: mountModulePlayer(el, def), section });
        }
      })
      .catch((e) => {
        console.error(e);
        host.innerHTML = '<p class="loading">Modulen kunde inte laddas.</p>';
      });
  }
</script>

<style>
  .module-host {
    display: grid;
    gap: 2.5rem;
  }
  .module-host :global(.module-part) {
    display: grid;
    gap: 0.8rem;
  }
  .placeholder,
  .module-host:has(.loading) {
    aspect-ratio: 16 / 9;
    max-width: 100%;
    display: grid;
    place-items: center;
    background: #000;
    border: 1px solid var(--line);
    color: var(--dim);
  }
  /* Rundade hörn som korten, så att spelaren hör ihop med resten av sidan. */
  :global(.ns-module) {
    border-radius: 16px;
    overflow: hidden;
  }
</style>
