---
// Quiz i slutet av en modul. Frågorna kommer från modulens frontmatter.
// Varje alternativ har en egen förklaring, och fel svar länkar tillbaka till
// kapitlet i modulens film där saken visas (data-seek, se ModuleStage.astro).
import { INTERACTIVE_MODULES } from '../lib/interactive';
import { KIND_LABEL, type QuizQuestion, orderedOptions, parseSee } from '../lib/quiz';

interface Props {
  slug: string;
  quiz: QuizQuestion[];
}
const { slug, quiz } = Astro.props;

// Kapitlens namn hämtas från modulens manus vid bygget.
const load = INTERACTIVE_MODULES[slug];
const parts = load ? (await load()).parts : [];
const chapterTitle = (see: string) => {
  const { part, chapter } = parseSee(see);
  return parts.find((p) => p.id === part)?.chapters.find((c) => c.id === chapter)?.title;
};

const questions = quiz.map((x) => ({ ...x, options: orderedOptions(x), chapter: chapterTitle(x.see) }));
---

<section class="quiz" data-quiz={slug} aria-labelledby={`quiz-${slug}`}>
  <h2 id={`quiz-${slug}`}>Testa dig själv</h2>
  <p class="note">
    {questions.length} frågor. Två om grunderna, en där du använder det du lärt dig och en där du förutsäger vad som händer.
  </p>
  <ol>
    {questions.map((x, qi) => (
      <li class="q">
        <fieldset>
          <legend>
            <span class="kind">
              Fråga {qi + 1} av {questions.length} · {KIND_LABEL[x.kind]}
            </span>
            <span class="qt">{x.q}</span>
          </legend>
          <div class="opts">
            {x.options.map((o) => (
              <button type="button" data-right={o.right ? '1' : '0'} data-why={o.why}>
                {o.text}
              </button>
            ))}
          </div>
        </fieldset>
        <div class="why" id={`quiz-${slug}-why-${qi}`} hidden>
          <p>
            <b class="verdict" /> <span class="explain" />
          </p>
          <p class="right-was" hidden>
            Rätt svar: <span />. {x.why}
          </p>
          {x.chapter && (
            <p class="back" hidden>
              <a href={`#del-${parseSee(x.see).part}`} data-seek={x.see}>
                Se kapitlet ”{x.chapter}” i filmen igen ↑
              </a>
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>
  <div class="result" hidden>
    <p class="score" role="status"></p>
    <button type="button" class="again">
      Gör om
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((root) => {
    const key = `ilearnai-quiz-${root.dataset.quiz}`;
    const items = [...root.querySelectorAll<HTMLLIElement>('.q')];
    const result = root.querySelector<HTMLDivElement>('.result')!;
    const scoreEl = result.querySelector<HTMLParagraphElement>('.score')!;
    let answered = 0,
      right = 0;
    const readBest = () => {
      try {
        return Number(localStorage.getItem(key)) || 0;
      } catch {
        return 0;
      }
    };

    items.forEach((li) => {
      const buttons = [...li.querySelectorAll<HTMLButtonElement>('.opts button')];
      const why = li.querySelector<HTMLDivElement>('.why')!;
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          if (li.classList.contains('done')) return;
          const ok = b.dataset.right === '1';
          const correct = buttons.find((x) => x.dataset.right === '1')!;
          li.classList.add('done');
          b.classList.add(ok ? 'right' : 'wrong');
          b.setAttribute('aria-pressed', 'true');
          correct.classList.add('right');
          buttons.forEach((x) => {
            x.disabled = true;
            x.setAttribute('aria-describedby', why.id);
          });
          why.querySelector('.verdict')!.textContent = ok ? 'Rätt.' : 'Inte riktigt.';
          why.querySelector('.explain')!.textContent = b.dataset.why ?? '';
          const rightWas = why.querySelector<HTMLParagraphElement>('.right-was')!;
          rightWas.hidden = ok;
          rightWas.querySelector('span')!.textContent = correct.textContent?.trim() ?? '';
          const back = why.querySelector<HTMLParagraphElement>('.back');
          if (back) back.hidden = ok;
          why.classList.toggle('ok', ok);
          why.hidden = false;
          answered++;
          if (ok) right++;
          if (answered === items.length) {
            const best = Math.max(readBest(), right);
            try {
              localStorage.setItem(key, String(best));
            } catch {
              // sparat resultat är bara en bekvämlighet
            }
            const tail = right === items.length ? ' Alla rätt!' : best > right ? ` Ditt bästa: ${best}.` : '';
            scoreEl.textContent = `${right} av ${items.length} rätt.${tail}`;
            result.hidden = false;
            root.dispatchEvent(new CustomEvent('quiz:done', { bubbles: true, detail: { right, total: items.length } }));
          }
        }),
      );
    });

    result.querySelector('.again')!.addEventListener('click', () => {
      answered = right = 0;
      result.hidden = true;
      items.forEach((li) => {
        li.classList.remove('done');
        li.querySelector<HTMLDivElement>('.why')!.hidden = true;
        li.querySelectorAll<HTMLButtonElement>('.opts button').forEach((x) => {
          x.disabled = false;
          x.classList.remove('right', 'wrong');
          x.removeAttribute('aria-pressed');
        });
      });
      items[0]?.querySelector('button')?.focus();
    });
  });
</script>

<style>
  .quiz {
    display: grid;
    gap: 1rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }
  .quiz h2 {
    margin: 0;
  }
  .quiz .note {
    margin: 0;
  }
  ol {
    display: grid;
    gap: 1.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    display: grid;
    gap: 0.2rem;
    margin-bottom: 0.6rem;
    padding: 0;
  }
  .kind {
    font: 400 0.72rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .qt {
    font-weight: 700;
  }
  .opts {
    display: grid;
    gap: 0.45rem;
  }
  .opts button {
    font: inherit;
    text-align: left;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
  }
  .opts button:hover:not(:disabled),
  .opts button:focus-visible {
    border-color: var(--cold);
  }
  .opts button:disabled {
    cursor: default;
    opacity: 0.6;
  }
  .opts button.right {
    border-color: var(--cold);
    border-width: 2px;
    opacity: 1;
  }
  .opts button.right::after {
    content: ' ✓';
  }
  .opts button.wrong {
    border-color: var(--warm);
    border-style: dashed;
    opacity: 1;
  }
  .opts button.wrong::after {
    content: ' ✗';
  }
  .why {
    margin-top: 0.6rem;
    color: var(--dim);
  }
  .why p {
    margin: 0 0 0.35rem;
  }
  .why .verdict {
    color: var(--warm);
  }
  .why.ok .verdict {
    color: var(--cold);
  }
  .back a {
    font-weight: 700;
  }
  .result {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .score {
    margin: 0;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .again {
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
    min-height: 44px;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }
</style>
