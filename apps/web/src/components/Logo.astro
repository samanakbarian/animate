---
// Loggan: märket (ett ”i” vars prick är en neuron med två mjuka ingångar) och
// ordbilden i det rundade typsnittet Nunito.
import '@fontsource/nunito/800.css';
---

<span class="logo">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <g fill="none" stroke="#a9c4e4" stroke-width="3.6" stroke-linecap="round">
      <path d="M14 12 C 16 22, 22 26, 30 26"></path>
      <path d="M50 12 C 48 22, 42 26, 34 26"></path>
    </g>
    <circle cx="14" cy="11" r="5" fill="#a9c4e4"></circle>
    <circle cx="50" cy="11" r="5" fill="#a9c4e4"></circle>
    <circle cx="32" cy="26" r="10" fill="#e07a52"></circle>
    <rect x="25.5" y="40" width="13" height="20" rx="6.5" fill="#eef0f2"></rect>
  </svg>
  <span class="word">
    Learn<b>AI</b>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.02em;
    font:
      800 1.4rem / 0.8 'Nunito',
      var(--font-sans);
    letter-spacing: -0.015em;
    color: #eef0f2;
  }
  svg {
    width: 1.5em;
    height: 1.5em;
    margin-bottom: -0.02em;
  }
  b {
    font-weight: 800;
    color: #a9c4e4;
  }
</style>
