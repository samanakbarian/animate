---
// Loggan: märket (ett ”i” vars prick är en neuron) och ordbilden i sajtens typsnitt.
---

<span class="logo">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <g stroke="#9db6d6" stroke-width="3.4" stroke-linecap="round">
      <line x1="12" y1="11" x2="32" y2="25"></line>
      <line x1="52" y1="11" x2="32" y2="25"></line>
    </g>
    <circle cx="12" cy="11" r="5.5" fill="#9db6d6"></circle>
    <circle cx="52" cy="11" r="5.5" fill="#9db6d6"></circle>
    <circle cx="32" cy="25" r="9.5" fill="#c8643f"></circle>
    <rect x="26" y="38" width="12" height="21" rx="6" fill="#e8ebee"></rect>
  </svg>
  <span class="word">
    Learn<b>AI</b>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.05em;
    font: 500 1.35rem / 1 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  svg {
    width: 1.5em;
    height: 1.5em;
    margin-bottom: -0.12em;
  }
  b {
    font-weight: 500;
    color: var(--cold);
  }
</style>
