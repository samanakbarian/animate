---
// Loggan ”Glöd”: ett ”i” vars prick glöder, som en tanke som sprider sig.
// Färgerna kommer från temat (--logo-*), ordbilden är satt i det rundade typsnittet Nunito.
import '@fontsource/nunito/800.css';
---

<span class="logo">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <circle class="glow" cx="32" cy="22" r="20" fill-opacity="0.12"></circle>
    <circle class="glow" cx="32" cy="22" r="14.5" fill-opacity="0.22"></circle>
    <circle class="glow" cx="32" cy="22" r="9.5"></circle>
    <rect class="stem" x="25.5" y="39" width="13" height="21" rx="6.5"></rect>
  </svg>
  <span class="word">
    Learn<b>AI</b>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.02em;
    font:
      800 1.4rem / 0.8 'Nunito',
      var(--font-sans);
    letter-spacing: -0.015em;
    color: var(--logo-ink);
  }
  /* Ringarna gör märket bredare än stapeln. Negativ högermarginal drar in ordet så att
     avståndet i–L blir som mellan bokstäver, och glöden hamnar svagt bakom L:et. */
  svg {
    width: 1.5em;
    height: 1.5em;
    margin-bottom: -0.02em;
    margin-right: -0.5em;
  }
  .word {
    position: relative;
  }
  .glow {
    fill: var(--logo-accent);
  }
  .stem {
    fill: var(--logo-ink);
  }
  b {
    font-weight: 800;
    color: var(--logo-word);
  }
</style>
