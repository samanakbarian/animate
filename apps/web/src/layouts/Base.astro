---
import '../styles/global.css';
import { SITE, canonicalPath } from '../lib/site';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} – film, moduler och spel om hur AI fungerar`;
const path = canonicalPath(Astro.url.pathname);
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
// Strukturerad data (schema.org): vem som står bakom sajten, så att sökmotorer och AI-modeller ser det.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#org`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/apple-touch-icon.png`,
      email: SITE.founder.email,
      foundingDate: SITE.foundingYear,
      founder: { '@id': `${SITE.url}/#grundare` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#grundare`,
      name: SITE.founder.name,
      jobTitle: `${SITE.founder.role}, ${SITE.name}`,
      email: `mailto:${SITE.founder.email}`,
      worksFor: { '@id': `${SITE.url}/#org` },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#webbplats`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'sv-SE',
      publisher: { '@id': `${SITE.url}/#org` },
      creator: { '@id': `${SITE.url}/#grundare` },
    },
  ],
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07090b" />
    <script is:inline>
      // Tema före första målningen (ingen blinkning): sparat val, annars systemets ljust/mörkt.
      (() => {
        let t = null;
        try {
          t = localStorage.getItem('ns-theme');
        } catch {
          // ingen lagring: följ systemet
        }
        if (t !== 'mork' && t !== 'ljus' && t !== 'hacker') t = matchMedia('(prefers-color-scheme: light)').matches ? 'ljus' : 'mork';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="author" href="/humans.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="author" content={SITE.founder.name} />
    <meta name="creator" content={SITE.founder.name} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: film, moduler och spel om hur AI fungerar`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">
      Hoppa till innehållet
    </a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${SITE.name}, till startsidan`}>
          <Logo />
        </a>
        <nav aria-label="Huvudmeny">
          {SITE.nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap bar">
        <span class="mono">{SITE.domain}</span>
        <a href="/om">Om sajten och kontakt</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--bg);
    padding: 0.5em 1em;
    z-index: 10;
  }
  .skip:focus {
    left: 1rem;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.1rem;
  }
  /* Stort: logga, meny, tema på en rad. Smalt: logga + tema överst, menyn under. */
  .site-header .bar {
    justify-content: flex-start;
  }
  .site-header .brand {
    margin-right: auto;
  }
  .site-header nav {
    order: 1;
  }
  .site-header :global(.theme) {
    order: 2;
  }
  @media (max-width: 640px) {
    .site-header nav {
      order: 3;
      width: 100%;
    }
  }
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .brand {
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }
  nav a {
    font: 400 1rem / 1 var(--font-sans);
    color: var(--dim);
    text-decoration: none;
    padding-block: 0.35rem;
  }
  nav a:hover {
    color: var(--ink);
  }
  /* Sidan du är på: en vågig, handritad understrykning. */
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline wavy var(--warm) 1.5px;
    text-underline-offset: 0.35em;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 6rem;
    color: var(--dim);
    font-size: var(--step--1);
  }
</style>
