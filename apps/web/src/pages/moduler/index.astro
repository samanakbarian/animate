---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import { STAGE_LABEL } from '../../lib/site';
import { STAGES } from '../../content.config';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Moduler" description="Korta filmer som förklarar hur AI fungerar, från en enda neuron till agenter.">
  <div class="wrap page">
    <header class="prose">
      <p class="eyebrow">{modules.length} moduler</p>
      <h1>Moduler</h1>
      <p>
        Varje modul tar ett par minuter. Den börjar som en film, och när den är slut kan du dra i reglagen själv. Du kan också pausa när som
        helst.
      </p>
    </header>
    {STAGES.map((stage) => (
      <section aria-label={STAGE_LABEL[stage]}>
        <h2 class="eyebrow">{STAGE_LABEL[stage]}</h2>
        <div class="grid">
          {modules
            .filter((m) => m.data.stage === stage)
            .map((m) => (
              <ModuleCard module={m} />
            ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 3rem;
    padding-block: 4rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
