---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import ModuleCard from '../components/ModuleCard.astro';
import GameCard from '../components/GameCard.astro';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const launch = modules.filter((m) => m.data.stage === 'mvp');
const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <FilmPlayer />

  <section class="wrap intro">
    <p class="eyebrow">2 min 30 s · från −300 000 till ∞</p>
    <h1>
      Hur fungerar AI <span class="scribble">egentligen</span>?
    </h1>
    <div class="prose">
      <p>
        Filmen ovan tar dig från de första människorna till dagens språkmodeller och vidare mot det som kanske kommer, på två och en halv
        minut. Resten av sajten tar det lugnare. Varje modul är en kort film som du kan stoppa när du vill och prova själv.
      </p>
      <p>Är du ny kan du börja med de tre första: hur ett neuralt nätverk fungerar, vad en språkmodell gör och vad en agent är.</p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="start-har">
    <div class="sec-head">
      <h2 id="start-har">Börja här</h2>
      <span class="note">tre korta moduler att börja med ↓</span>
    </div>
    <div class="grid">
      {launch.map((m) => (
        <ModuleCard module={m} />
      ))}
    </div>
    <p class="more">
      <a href="/moduler">Alla {modules.length} moduler →</a>
    </p>
  </section>

  <section class="wrap games" aria-labelledby="spela">
    <div class="sec-head">
      <h2 id="spela">Eller lär dig genom att spela</h2>
      <span class="note">några minuter per spel ↓</span>
    </div>
    <div class="grid">
      {games.map((g) => (
        <GameCard game={g} />
      ))}
    </div>
    <p class="more">
      <a href="/spel">Alla spel →</a>
    </p>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: 1.4rem;
    padding-block: 4rem 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .games {
    padding-top: 3rem;
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
  }
  .more {
    margin-top: 1.5rem;
    font-weight: 700;
  }
</style>
