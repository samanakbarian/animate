{
  "name": "nastasteg",
  "private": true,
  "description": "ilearnai.se – AI förklarat från grunden, med kortfilmen NÄSTA STEG som ingång.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nastasteg/web dev",
    "dev:film": "pnpm --filter @nastasteg/film dev",
    "build": "pnpm --filter @nastasteg/web build",
    "build:film": "pnpm --filter @nastasteg/film build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "render": "pnpm --filter @nastasteg/render render",
    "frames": "pnpm --filter @nastasteg/render preview",
    "module-frames": "pnpm --filter @nastasteg/render module-frames"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
